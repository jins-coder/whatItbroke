{
  "name": "whatitbroke",
  "version": "1.0.0",
  "type": "module",
  "description": "Universal Application Debugger and Root-Cause Analysis CLI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "whatitbroke": "bin/whatitbroke.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@whatitbroke/shared": "1.0.0",
    "@whatitbroke/core": "1.0.0",
    "@whatitbroke/node": "1.0.0",
    "@whatitbroke/react": "1.0.0",
    "@whatitbroke/vue": "1.0.0",
    "@whatitbroke/angular": "1.0.0",
    "@whatitbroke/ai": "1.0.0"
  },
  "keywords": [
    "debugger",
    "cli",
    "root-cause",
    "diagnostics",
    "stacktrace",
    "sourcemap",
    "whatitbroke"
  ],
  "author": "WhatItBroke Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
