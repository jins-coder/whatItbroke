{
  "name": "@whatitbroke/core",
  "version": "1.0.4",
  "type": "module",
  "description": "Core debug engine, stack parser, sourcemap resolver, timeline, and root-cause analyzer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
