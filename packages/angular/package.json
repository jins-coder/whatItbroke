  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@whatitbroke/shared": "^1.0.2",
    "@whatitbroke/core": "^1.0.2"
  },
  "peerDependencies": {
    "@angular/core": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    }
  },
  "license": "MIT"
}
