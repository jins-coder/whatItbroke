{
  "name": "@whatitbroke/angular",
  "version": "1.0.2",
  "type": "module",
  "description": "Angular adapter, ErrorHandler, DI analyzer, and RxJS tracker for WhatItBroke",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
