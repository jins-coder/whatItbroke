{
  "name": "@whatitbroke/node",
  "version": "1.0.1",
  "type": "module",
  "description": "Node.js debug adapter, async context tracker, and HTTP/DB event collectors",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@whatitbroke/shared": "^1.0.1",
    "@whatitbroke/core": "^1.0.1"
  },
  "keywords": [
    "debugger",
    "node",
    "root-cause",
    "uncaughtException"
  ],
  "author": "WhatItBroke Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
