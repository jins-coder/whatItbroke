{
  "name": "@whatitbroke/vue",
  "version": "1.0.1",
  "type": "module",
  "description": "Vue 3 adapter, error handler plugin, and reactive state debugger for WhatItBroke",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@whatitbroke/shared": "^1.0.1",
    "@whatitbroke/core": "^1.0.1"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "keywords": [
    "debugger",
    "vue",
    "vue3",
    "reactivity",
    "root-cause"
  ],
  "author": "WhatItBroke Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
