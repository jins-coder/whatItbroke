{
  "name": "@whatitbroke/shared",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared types, redaction, and utilities for WhatItBroke",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["debugger", "shared"],
  "author": "WhatItBroke Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
